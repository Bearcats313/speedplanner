ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=         # only needed if your key is identity-linked (400 "anthropic-workspace-id is required" without it); leave blank for a classic API key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # scripts only (import-catalog, enrich-catalog) — never in the app bundle
SPEEDIANCE_REGION=Global        # Global | EU (case-sensitive) — verified against speediance-cli's baseURLs map; anything else falls back to Global
SPEEDIANCE_DEVICE_TYPE=1        # a plain integer API code, unrelated to the GM1/GM2 name — speediance-cli's own
                                 # default and "only tested device" (internal/config/config.go); not yet
                                 # independently confirmed this is right for GM2 specifically, but nothing in
                                 # the CLI's source does any GM1-vs-GM2 device-type switching at all, so this
                                 # is very likely simply the correct value regardless of machine generation.
